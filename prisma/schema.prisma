// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 수정후 DB에 반영
// npx prisma migrate dev --name init
// npm prisma db push

model User {
  id    Int     @default(autoincrement()) @id
  created DateTime @default(now())
  updated DateTime @updatedAt
  
  // 필수값
  name  String
  email String  @unique
  password String

  file   Files? @relation(fields: [profileImgId], references: [id])
  profileImgId Int? @unique
  
  email_sub String?
  birth String?
  country String?
  phone String?
  passport_f_name String?
  passport_name String?
  passport_number String?
  gender Gender?
  staying_country String?

  id_type IdType @default(none)
  
  address String?

  use_lang String?

  role Role @default(USER)
  isActive Boolean @default(true)

  snsToken SnsToken?
  token Token?
  payCard PayCard?
}

model PayCard{
  id    Int  @id @default(autoincrement())
  created DateTime @default(now())
  updated DateTime @updatedAt
  
  user   User @relation(fields: [userId], references: [id])
  userId Int @unique
  
  number String @unique
  name String
}

model SnsToken{
  id    Int     @default(autoincrement()) @id
  created DateTime @default(now())
  updated DateTime @updatedAt
  type SnsTokenType
  token String @unique
  user   User @relation(fields: [userId], references: [id])
  userId Int @unique
}

model Token{
  id    Int  @id @default(autoincrement())
  created DateTime @default(now())
  updated DateTime @updatedAt
  user   User @relation(fields: [userId], references: [id])
  userId Int @unique
  token String @unique
}

model Files{
  id    Int  @id @default(autoincrement())
  originalname String 
  encoding String
  mimetype String
  destination String
  filename String
  path String
  size Int
  more01 String
  more02 String
  created DateTime @default(now())
  updated DateTime @updatedAt
  user User?
}

enum Gender{
  M
  F
  X
}
enum IdType{
  none
  foreignerCard
  passport
  registrationCard
}

enum CodeType{
  ERROR
}

enum Role{
  USER
  ADMIN
  SUPER
}

enum SnsTokenType{
  KAKAO
  APPLE
  LINE
  WECHAT
  GOOGLE
}